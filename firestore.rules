rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Funciones base de seguridad (docs/04_seguridad_y_functions.md y .agents/rules/firebase.md)
    function estaAutenticado() {
      return request.auth != null;
    }

    function esElPropioUsuario(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    function esMiembroActivo(hogarId) {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/hogares/$(hogarId)/miembros/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/hogares/$(hogarId)/miembros/$(request.auth.uid)).data.estado == 'activo';
    }

    function esAdmin(hogarId) {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/hogares/$(hogarId)) &&
        get(/databases/$(database)/documents/hogares/$(hogarId)).data.adminUid == request.auth.uid;
    }

    function diaInicioValido(dia) {
      return dia is int && dia >= 1 && dia <= 28;
    }

    // Slice 1: Colección usuarios/{uid}
    match /usuarios/{uid} {
      allow read: if esElPropioUsuario(uid);

      allow create: if esElPropioUsuario(uid) &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        diaInicioValido(request.resource.data.diaInicioPeriodo) &&
        (!('hogarId' in request.resource.data) || request.resource.data.hogarId == null);

      allow update: if esElPropioUsuario(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hogarId', 'creadoEn']) &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() > 0 &&
        request.resource.data.email is string &&
        diaInicioValido(request.resource.data.diaInicioPeriodo);

      allow delete: if false;
    }

    // Slice 2: Colección hogares/{hogarId} y subcolecciones de Hogar / QR / Presupuestos
    // docs/04_seguridad_y_functions.md:
    // - hogares/{h}: read miembro activo; create/update/delete no (Function)
    // - miembros, auditoria, resumenes, usoIA: read miembro activo; write no (Function)
    // - invitaciones: read solo admin miembro activo; write no (Function)
    // - presupuestos/{uid}_{p}: read miembro activo; create/update ese uid con monto int > 0; delete no
    match /hogares/{hogarId} {
      allow read: if esMiembroActivo(hogarId);
      allow write: if false;

      match /miembros/{miembroUid} {
        allow read: if esMiembroActivo(hogarId);
        allow write: if false;
      }

      match /invitaciones/{invitacionId} {
        allow read: if esMiembroActivo(hogarId) && esAdmin(hogarId);
        allow write: if false;
      }

      match /presupuestos/{presupuestoId} {
        allow read: if esMiembroActivo(hogarId);

        allow create, update: if esMiembroActivo(hogarId) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.periodoId is string &&
          request.resource.data.periodoId.size() == 10 &&
          presupuestoId == (request.auth.uid + '_' + request.resource.data.periodoId) &&
          request.resource.data.monto is int &&
          request.resource.data.monto > 0;

        allow delete: if false;
      }

      match /auditoria/{auditoriaId} {
        allow read: if esMiembroActivo(hogarId);
        allow write: if false;
      }

      match /resumenes/{resumenId} {
        allow read: if esMiembroActivo(hogarId);
        allow write: if false;
      }

      match /usoIA/{usoId} {
        allow read: if esMiembroActivo(hogarId);
        allow write: if false;
      }
    }

    // Niega todo lo demás por defecto hasta abrir cada colección en sus slices correspondientes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
