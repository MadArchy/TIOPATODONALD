rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Funciones base de seguridad (docs/04_seguridad_y_functions.md y .agents/rules/firebase.md)
    function estaAutenticado() {
      return request.auth != null;
    }

    function esElPropioUsuario(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    function esMiembroActivo(hogarId) {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/hogares/$(hogarId)/miembros/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/hogares/$(hogarId)/miembros/$(request.auth.uid)).data.estado == 'activo';
    }

    function esAdmin(hogarId) {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/hogares/$(hogarId)) &&
        get(/databases/$(database)/documents/hogares/$(hogarId)).data.adminUid == request.auth.uid;
    }

    function diaInicioValido(dia) {
      return dia is int && dia >= 1 && dia <= 28;
    }

    // Slice 1: Colección usuarios/{uid}
    match /usuarios/{uid} {
      allow read: if esElPropioUsuario(uid);

      allow create: if esElPropioUsuario(uid) &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        diaInicioValido(request.resource.data.diaInicioPeriodo) &&
        (!('hogarId' in request.resource.data) || request.resource.data.hogarId == null);

      allow update: if esElPropioUsuario(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'hogarId',
          'creadoEn',
          'diaInicioAnterior',
          'enPuentePeriodo'
        ]) &&
        // #10: una vez configurado el período inicial, el cliente no puede cambiar
        // `diaInicioPeriodo` directo (debe usar `diaInicioPendiente` y esperar a `cerrarPeriodos`).
        (resource.data.get('periodoConfigurado', false) != true ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'diaInicioPeriodo',
            'periodoConfigurado'
          ])) &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() > 0 &&
        request.resource.data.email is string &&
        diaInicioValido(request.resource.data.diaInicioPeriodo);

      allow delete: if false;
    }

    // Slice 2: Colección hogares/{hogarId} y subcolecciones de Hogar / QR / Presupuestos
    // docs/04_seguridad_y_functions.md:
    // - hogares/{h}: read miembro activo; create/update/delete no (Function)
    // - miembros, auditoria, resumenes, usoIA: read miembro activo; write no (Function)
    // - invitaciones: read solo admin miembro activo; write no (Function)
    // - presupuestos/{uid}_{p}: read miembro activo; create/update ese uid con monto int > 0; delete no
    match /hogares/{hogarId} {
      allow read: if esMiembroActivo(hogarId);
      allow write: if false;

      match /miembros/{miembroUid} {
        allow read: if esMiembroActivo(hogarId);
        allow write: if false;
      }

      match /invitaciones/{invitacionId} {
        allow read: if esMiembroActivo(hogarId) && esAdmin(hogarId);
        allow write: if false;
      }

      match /presupuestos/{presupuestoId} {
        allow read: if esMiembroActivo(hogarId);

        // Creación inicial del presupuesto del período por el propio usuario.
        // Cambios posteriores de monto pasan por `cambiarPresupuesto` (auditoría)
        // y `alertasEnviadas` solo lo actualiza el servidor (`alCrearMovimiento`).
        allow create: if esMiembroActivo(hogarId) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.periodoId is string &&
          request.resource.data.periodoId.size() == 10 &&
          presupuestoId == (request.auth.uid + '_' + request.resource.data.periodoId) &&
          request.resource.data.monto is int &&
          request.resource.data.monto > 0;

        allow update, delete: if false;
      }

      // Slice 3 — movimientos y gastos fijos
      match /movimientos/{movimientoId} {
        allow read: if esMiembroActivo(hogarId);

        allow create: if esMiembroActivo(hogarId) && movimientoCreateOk(hogarId);

        allow update: if esMiembroActivo(hogarId) &&
          (edicionMenorOk() || completarFotoPathOk(hogarId, movimientoId));

        allow delete: if false;
      }

      match /gastosFijos/{gastoFijoId} {
        allow read: if esMiembroActivo(hogarId);

        allow create: if esMiembroActivo(hogarId) &&
          request.resource.data.uid == request.auth.uid &&
          gastoFijoCamposOk(request.resource.data);

        allow update: if esMiembroActivo(hogarId) &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid &&
          gastoFijoCamposOk(request.resource.data);

        allow delete: if esMiembroActivo(hogarId) &&
          resource.data.uid == request.auth.uid;
      }

      // Slice 5 — deudas externas (saldoActual solo servidor / create igual a inicial)
      match /deudas/{deudaId} {
        allow read: if esMiembroActivo(hogarId);

        allow create: if esMiembroActivo(hogarId) &&
          esAdmin(hogarId) &&
          deudaCreateOk();

        allow update: if esMiembroActivo(hogarId) &&
          esAdmin(hogarId) &&
          deudaUpdateOk();

        allow delete: if false;
      }

      // Slice 6 — deudas entre miembros
      match /deudasInternas/{deudaInternaId} {
        allow read: if esMiembroActivo(hogarId) &&
          esParteDeudaInternaOAdmin(hogarId);

        allow create: if esMiembroActivo(hogarId) &&
          deudaInternaCreateOk();

        allow update: if esMiembroActivo(hogarId) &&
          deudaInternaUpdateOk();

        allow delete: if false;

        match /pagos/{pagoId} {
          allow read: if esMiembroActivo(hogarId) &&
            esParteDeudaInternaPadreOAdmin(hogarId, deudaInternaId);

          allow create: if esMiembroActivo(hogarId) &&
            pagoInternoCreateOk(hogarId, deudaInternaId);

          allow update: if false;
          allow delete: if false;
        }
      }

      // Slice 7 — correcciones (update/delete solo Function)
      match /correcciones/{correccionId} {
        allow read: if esMiembroActivo(hogarId);

        allow create: if esMiembroActivo(hogarId) &&
          correccionCreateOk();

        allow update, delete: if false;
      }

      match /auditoria/{auditoriaId} {
        allow read: if esMiembroActivo(hogarId);
        allow write: if false;
      }

      match /resumenes/{resumenId} {
        allow read: if esMiembroActivo(hogarId);
        allow write: if false;
      }

      match /usoIA/{usoId} {
        allow read: if esMiembroActivo(hogarId);
        allow write: if false;
      }

      // Slice 8 — chat por usuario
      match /chats/{chatUid}/mensajes/{mensajeId} {
        allow read: if esMiembroActivo(hogarId) && request.auth.uid == chatUid;

        allow create: if esMiembroActivo(hogarId) &&
          request.auth.uid == chatUid &&
          mensajeChatCreateOk();

        allow update: if esMiembroActivo(hogarId) &&
          request.auth.uid == chatUid &&
          mensajeChatUpdateOk();

        allow delete: if false;
      }
    }

    function categoriasGasto() {
      return ['alimentacion', 'servicios', 'transporte', 'vivienda',
        'salud', 'educacion', 'ocio', 'otros'];
    }

    function categoriasIngreso() {
      return ['salario', 'otros_ingreso'];
    }

    function categoriaMovimientoOk(tipo, categoria) {
      return (tipo == 'gasto' && categoria in categoriasGasto()) ||
        (tipo == 'ingreso' && categoria in categoriasIngreso()) ||
        (tipo == 'pagoCuota' && categoria == null);
    }

    function periodoIdFormatoOk(periodoId) {
      return periodoId is string &&
        periodoId.size() == 10 &&
        periodoId[4:5] == '-' &&
        periodoId[7:8] == '-';
    }

    function usuarioActualDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function diaPeriodoPermitido(diaPeriodo) {
      let u = usuarioActualDoc();
      return diaPeriodo == u.diaInicioPeriodo ||
        ('diaInicioAnterior' in u && u.diaInicioAnterior is int && diaPeriodo == u.diaInicioAnterior);
    }

    // #8 + B4: periodoId debe corresponder al día de inicio del usuario (o al día
    // anterior en transición offline), fecha no futura, dentro de ventana offline (62 d),
    // y caer dentro del rango [inicioPeriodo, inicioPeriodo + 32 días) en America/Bogota.
    function periodoMovimientoOk(fecha, periodoId) {
      let inicioPeriodoUtc = timestamp.date(
        int(periodoId[0:4]),
        int(periodoId[5:7]),
        int(periodoId[8:10])
      ) + duration.value(5, 'h');
      return periodoIdFormatoOk(periodoId) &&
        diaPeriodoPermitido(int(periodoId[8:10])) &&
        fecha is timestamp &&
        fecha <= request.time &&
        fecha > request.time - duration.value(62, 'd') &&
        fecha >= inicioPeriodoUtc &&
        fecha < inicioPeriodoUtc + duration.value(32, 'd');
    }

    function deudaExiste(hogarId, deudaId) {
      return deudaId is string &&
        deudaId.size() > 0 &&
        exists(/databases/$(database)/documents/hogares/$(hogarId)/deudas/$(deudaId)) &&
        get(/databases/$(database)/documents/hogares/$(hogarId)/deudas/$(deudaId)).data.estado == 'activa';
    }

    function movimientoCreateOk(hogarId) {
      let d = request.resource.data;
      return d.uid == request.auth.uid &&
        d.tipo in ['gasto', 'ingreso', 'pagoCuota'] &&
        d.monto is int &&
        d.monto > 0 &&
        categoriaMovimientoOk(d.tipo, d.categoria) &&
        (d.tipo != 'pagoCuota' || deudaExiste(hogarId, d.deudaId)) &&
        (d.tipo == 'pagoCuota' || d.deudaId == null) &&
        periodoMovimientoOk(d.fecha, d.periodoId) &&
        d.estado == 'activo' &&
        d.creadoEn == request.time &&
        d.saldoAplicado == false &&
        (d.origen in ['formulario', 'chat', 'gastoFijo']) &&
        (d.nota is string && d.nota.size() <= 200) &&
        (d.fotoPath == null || d.fotoPath is string) &&
        (d.editadoEn == null) &&
        (d.gastoFijoId == null || d.gastoFijoId is string);
    }

    function deudaCreateOk() {
      let d = request.resource.data;
      return d.entidad is string &&
        d.entidad.size() > 0 &&
        d.saldoInicial is int &&
        d.saldoInicial > 0 &&
        d.saldoActual is int &&
        d.saldoActual == d.saldoInicial &&
        d.cuotaMensual is int &&
        d.cuotaMensual > 0 &&
        d.diaPago is int &&
        d.diaPago >= 1 &&
        d.diaPago <= 31 &&
        (d.numeroCuotas == null || (d.numeroCuotas is int && d.numeroCuotas > 0)) &&
        d.estado == 'activa' &&
        d.creadaEn == request.time;
    }

    function deudaUpdateOk() {
      let before = resource.data;
      let after = request.resource.data;
      return after.saldoActual == before.saldoActual &&
        after.saldoInicial == before.saldoInicial &&
        after.creadaEn == before.creadaEn &&
        after.entidad is string &&
        after.entidad.size() > 0 &&
        after.cuotaMensual is int &&
        after.cuotaMensual > 0 &&
        after.diaPago is int &&
        after.diaPago >= 1 &&
        after.diaPago <= 31 &&
        (after.numeroCuotas == null ||
          (after.numeroCuotas is int && after.numeroCuotas > 0)) &&
        after.estado in ['activa', 'pagada', 'desactivada'];
    }

    function edicionMenorOk() {
      let before = resource.data;
      let after = request.resource.data;
      return before.uid == request.auth.uid &&
        before.estado == 'activo' &&
        request.time < before.creadoEn + duration.value(24, 'h') &&
        after.diff(before).affectedKeys().hasOnly(['nota', 'categoria', 'editadoEn']) &&
        after.nota is string &&
        after.nota.size() <= 200 &&
        after.editadoEn == request.time &&
        (
          !after.diff(before).affectedKeys().hasAny(['categoria']) ||
          (before.tipo == 'gasto' && after.categoria in categoriasGasto())
        ) &&
        after.tipo == before.tipo &&
        after.monto == before.monto &&
        after.uid == before.uid &&
        after.periodoId == before.periodoId &&
        after.estado == before.estado;
    }

    function completarFotoPathOk(hogarId, movimientoId) {
      let before = resource.data;
      let after = request.resource.data;
      return before.uid == request.auth.uid &&
        before.fotoPath == null &&
        after.diff(before).affectedKeys().hasOnly(['fotoPath']) &&
        after.fotoPath == 'recibos/' + hogarId + '/' + movimientoId + '.jpg';
    }

    function gastoFijoCamposOk(d) {
      return d.nombre is string &&
        d.nombre.size() > 0 &&
        d.monto is int &&
        d.monto > 0 &&
        d.categoria in categoriasGasto() &&
        d.diaEsperado is int &&
        d.diaEsperado >= 1 &&
        d.diaEsperado <= 31 &&
        d.activo is bool;
    }

    function esParteDeudaInternaOAdmin(hogarId) {
      return esAdmin(hogarId) ||
        resource.data.acreedorUid == request.auth.uid ||
        resource.data.deudorUid == request.auth.uid;
    }

    function esParteDeudaInternaPadreOAdmin(hogarId, deudaInternaId) {
      let d = get(/databases/$(database)/documents/hogares/$(hogarId)/deudasInternas/$(deudaInternaId)).data;
      return esAdmin(hogarId) ||
        d.acreedorUid == request.auth.uid ||
        d.deudorUid == request.auth.uid;
    }

    function deudaInternaCreateOk() {
      let d = request.resource.data;
      return d.acreedorUid == request.auth.uid &&
        d.deudorUid is string &&
        d.deudorUid.size() > 0 &&
        d.deudorUid != request.auth.uid &&
        d.montoInicial is int &&
        d.montoInicial > 0 &&
        d.saldo is int &&
        d.saldo == d.montoInicial &&
        d.concepto is string &&
        d.concepto.size() > 0 &&
        d.concepto.size() <= 200 &&
        d.estado == 'pendiente' &&
        d.creadaEn == request.time;
    }

    function deudaInternaUpdateOk() {
      let before = resource.data;
      let after = request.resource.data;
      return before.deudorUid == request.auth.uid &&
        before.estado == 'pendiente' &&
        after.diff(before).affectedKeys().hasOnly(['estado']) &&
        after.estado in ['aceptada', 'rechazada'] &&
        after.acreedorUid == before.acreedorUid &&
        after.deudorUid == before.deudorUid &&
        after.montoInicial == before.montoInicial &&
        after.saldo == before.saldo &&
        after.concepto == before.concepto &&
        after.creadaEn == before.creadaEn;
    }

    function pagoInternoCreateOk(hogarId, deudaInternaId) {
      let d = get(/databases/$(database)/documents/hogares/$(hogarId)/deudasInternas/$(deudaInternaId)).data;
      let p = request.resource.data;
      return d.deudorUid == request.auth.uid &&
        d.estado == 'aceptada' &&
        p.registradoPor == request.auth.uid &&
        p.monto is int &&
        p.monto > 0 &&
        p.fecha is timestamp &&
        p.fecha <= request.time &&
        p.confirmado == false &&
        p.confirmadoEn == null;
    }

    function correccionCreateOk() {
      let d = request.resource.data;
      return d.solicitanteUid == request.auth.uid &&
        d.movimientoId is string &&
        d.movimientoId.size() > 0 &&
        d.motivo is string &&
        d.motivo.size() > 0 &&
        d.motivo.size() <= 500 &&
        d.cambios is map &&
        d.cambios.keys().size() > 0 &&
        d.estado == 'pendiente' &&
        d.creadoEn == request.time &&
        d.resueltaPor == null &&
        d.resueltaEn == null &&
        d.motivoRechazo == null;
    }

    function mensajeChatCreateOk() {
      let d = request.resource.data;
      return d.rol in ['usuario', 'app', 'ia'] &&
        d.texto is string &&
        d.texto.size() > 0 &&
        d.texto.size() <= 2000 &&
        d.estado in ['propuesto', 'confirmado', 'descartado'] &&
        d.fecha == request.time &&
        (!('intencion' in d) || d.intencion == null || d.intencion is map);
    }

    function mensajeChatUpdateOk() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['estado']) &&
        after.estado in ['propuesto', 'confirmado', 'descartado'] &&
        after.rol == before.rol &&
        after.texto == before.texto &&
        after.fecha == before.fecha;
    }

    // Niega todo lo demás por defecto hasta abrir cada colección en sus slices correspondientes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
